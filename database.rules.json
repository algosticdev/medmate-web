{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && !data.exists()",
        ".validate": "newData.hasChildren(['role','name','email','createdAt'])",
        "role": {
          ".validate": "newData.val() == 'caregiver'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() == auth.token.email && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('userId').val() == auth.uid && newData.child('email').val() == auth.token.email && newData.child('status').val() == 'NEW' && !newData.child('reviewedAt').exists() && !newData.child('reviewedBy').exists()) || (data.exists() && newData.exists() && root.child('users').child(auth.uid).child('role').val() == 'admin' && newData.child('userId').val() == data.child('userId').val() && newData.child('name').val() == data.child('name').val() && newData.child('email').val() == data.child('email').val() && newData.child('subject').val() == data.child('subject').val() && newData.child('message').val() == data.child('message').val() && newData.child('createdAt').val() == data.child('createdAt').val() && newData.child('status').val() == 'REVIEWED' && newData.child('reviewedBy').val() == auth.uid && newData.child('reviewedAt').isNumber()))",
        ".validate": "newData.hasChildren(['userId','name','email','subject','message','status','createdAt'])",
        "userId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
        },
        "status": {
          ".validate": "newData.val() == 'NEW' || newData.val() == 'REVIEWED'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "reviewedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "reviewedBy": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (!data.exists() || data.child('ownerUid').val() == auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'caregiver' && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.child('ownerUid').val() == auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['ownerUid','paired','pairedAt']) && newData.child('ownerUid').val() == auth.uid && newData.child('paired').val() == true && newData.child('pairedAt').isNumber() && $deviceId.matches(/^MEDMATE_[A-Z0-9_-]{1,55}$/)",
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid && newData.val().length > 0 && newData.val().length <= 128"
        },
        "paired": {
          ".validate": "newData.isBoolean() && newData.val() == true"
        },
        "pairedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && (root.child('users').child(auth.uid).child('role').val() == 'caregiver' || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "pairedDevices": {
          "$deviceId": {
            ".write": "auth != null && auth.uid == $uid && root.child('users').child(auth.uid).child('role').val() == 'caregiver'",
            ".validate": "newData.hasChildren(['paired','pairedAt']) && newData.child('paired').val() == true && newData.child('pairedAt').isNumber() && $deviceId.matches(/^MEDMATE_[A-Z0-9_-]{1,55}$/)",
            "paired": {
              ".validate": "newData.isBoolean() && newData.val() == true"
            },
            "pairedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "catalog": {
          ".write": "auth != null && auth.uid == $uid && (root.child('users').child(auth.uid).child('role').val() == 'caregiver' || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          "medicines": {
            "$id": {
              ".validate": "newData.hasChildren(['name','currentStock','minimumStock','createdAt','updatedAt']) && newData.child('updatedAt').val() >= newData.child('createdAt').val()",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "currentStock": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
              },
              "minimumStock": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "schedules": {
            "$id": {
              ".validate": "newData.hasChildren(['medicineId','medicineName','scheduledTime','compartmentId','onTimeWindow','gracePeriod','active','createdAt','updatedAt']) && newData.child('updatedAt').val() >= newData.child('createdAt').val() && newData.parent().parent().child('medicines').child(newData.child('medicineId').val()).exists()",
              "medicineId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
              },
              "medicineName": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "scheduledTime": {
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "compartmentId": {
                ".validate": "newData.isString() && newData.val().matches(/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)-(A|B)$/)"
              },
              "onTimeWindow": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440 && newData.val() % 1 == 0"
              },
              "gracePeriod": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440 && newData.val() % 1 == 0"
              },
              "active": {
                ".validate": "newData.isBoolean()"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "scheduleVersions": {
            "$id": {
              "$revision": {
                ".validate": "newData.hasChildren(['medicineId','medicineName','scheduledTime','compartmentId','onTimeWindow','gracePeriod','active','createdAt','updatedAt']) && newData.child('updatedAt').val() >= newData.child('createdAt').val()",
                "medicineId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                },
                "medicineName": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "scheduledTime": {
                  ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
                },
                "compartmentId": {
                  ".validate": "newData.isString() && newData.val().matches(/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)-(A|B)$/)"
                },
                "onTimeWindow": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440 && newData.val() % 1 == 0"
                },
                "gracePeriod": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440 && newData.val() % 1 == 0"
                },
                "active": {
                  ".validate": "newData.isBoolean()"
                },
                "createdAt": {
                  ".validate": "newData.isNumber() && newData.val() > 0"
                },
                "updatedAt": {
                  ".validate": "newData.isNumber() && newData.val() > 0"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "stockAlerts": {
            "$medicineId": {
              ".validate": "newData.hasChildren(['id','alertType','medicineId','medicineName','currentStock','minimumStock','timestamp','source'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180"
              },
              "alertType": {
                ".validate": "newData.val() == 'LOW_STOCK' || newData.val() == 'REFILL_REQUIRED'"
              },
              "medicineId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
              },
              "medicineName": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "currentStock": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
              },
              "minimumStock": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
              },
              "timestamp": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "source": {
                ".validate": "newData.val() == 'stock'"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "caregiver": {
          ".write": "auth != null && auth.uid == $uid && (root.child('users').child(auth.uid).child('role').val() == 'caregiver' || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".validate": "newData.hasChildren(['name','email','notificationPreference','notificationsEnabled','eventCategories','updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "email": {
            ".validate": "auth.token.email_verified == true && newData.isString() && newData.val() == auth.token.email && newData.val().length <= 254"
          },
          "phoneNumber": {
            ".validate": "newData.isString() && newData.val() == auth.token.phone_number && newData.val().matches(/^\\+[1-9][0-9]{7,14}$/)"
          },
          "notificationPreference": {
            ".validate": "newData.val() == 'in_app' || newData.val() == 'email'"
          },
          "notificationsEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "eventCategories": {
            ".validate": "newData.hasChildren(['MISSED','WRONG_COMPARTMENT'])",
            "MISSED": {
              ".validate": "newData.val() == true"
            },
            "WRONG_COMPARTMENT": {
              ".validate": "newData.val() == true"
            },
            "$other": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "alertReads": {
          "$id": {
            ".write": "auth != null && auth.uid == $uid && (root.child('users').child(auth.uid).child('role').val() == 'caregiver' || root.child('users').child(auth.uid).child('role').val() == 'admin')",
            ".validate": "newData.isBoolean() && newData.val() == true"
          }
        },
        "events": {
          ".write": false,
          ".indexOn": [
            "timestamp",
            "scheduledDate",
            "medicineId",
            "compartmentId",
            "eventType"
          ]
        },
        "alerts": {
          ".write": false,
          ".indexOn": ["timestamp"]
        },
        "devices": {
          ".write": false
        },
        "compartments": {
          ".write": false
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
