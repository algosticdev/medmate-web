# FR-26 caregiver email (Brevo transactional email API).
#
# PROTOTYPE ONLY: these VITE_ variables are bundled into the browser
# JavaScript and are visible to anyone who opens devtools or inspects the
# network tab. Do not treat VITE_BREVO_API_KEY as secret, and do not use
# this setup in production — a real deployment must call Brevo from a
# server (Cloud Function, Vercel/Netlify function, etc.) instead.
VITE_BREVO_API_KEY=
VITE_BREVO_SENDER_EMAIL=
VITE_BREVO_SENDER_NAME=MedMate
